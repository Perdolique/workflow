{
  "name": "pantry-api",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "26.12.0"
  },
  "scripts": {
    "dev": "node scripts/check-config.ts && cf dev",
    "types": "cf workers types",
    "typecheck": "pnpm types && tsc --noEmit",
    "lint": "pnpm types && oxlint --type-aware",
    "format:check": "worsier --check .",
    "lint:md": "markdownlint-cli2 '**/*.md' '.github/**/*.md' '#node_modules' '#.cloudflare'",
    "knip": "knip",
    "test": "vitest run",
    "build": "cf build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm lint:md && pnpm knip && pnpm test && pnpm build"
  },
  "dependencies": {
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@types/node": "26.6.5",
    "cf": "1.0.0-beta.18",
    "eslint-config-greenpie": "17.15.0",
    "knip": "6.42.0",
    "markdownlint-cli2": "0.23.3",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "worsier": "3.10.1",
    "wrangler": "4.151.1"
  }
}
