{
  "name": "workflow",
  "version": "1.0.0",
  "type": "module",
  "description": "Useful tools and utilities",
  "scripts": {
    "test": "vp node --test scripts/setup-global-skills.test.ts",
    "lint:markdown": "markdownlint '**/*.md' '.agents/**/*.md'",
    "lint:skills": "./scripts/lint-skills.sh",
    "setup:skills": "./scripts/setup-global-skills.sh",
    "update:skills": "vpx skills update --global",
    "update:all": "taze --include-locked --interactive",
    "prepare": "husky"
  },
  "keywords": [
    "tools",
    "utilities",
    "workflow",
    "skills"
  ],
  "author": "Perdolique",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "husky": "9.1.7",
    "markdownlint": "0.42.1",
    "markdownlint-cli": "0.50.0",
    "taze": "21.3.0",
    "worsier": "3.10.1"
  }
}
